{
  "name": "fantasta",
  "productName": "Fantasta",
  "version": "1.1.0",
  "description": "Banco d'asta per il Fantacalcio: listone aggiornato, assegnazioni, rose, formazioni e rigoristi",
  "main": "main.js",
  "author": "Alessandro Botti",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64 --arm64"
  },
  "build": {
    "appId": "it.inema.fantasta",
    "productName": "Fantasta",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "xlsx.js",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Fantasta"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fantasta",
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "language": "1040",
      "artifactName": "${productName}-${version}-${arch}-installer.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portatile.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}